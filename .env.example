# ─── Admin credentials ────────────────────────────────────────────────────────
# Seeded on first backend startup (Story 1.2) — idempotent
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-secure-password

# ─── JWT configuration ────────────────────────────────────────────────────────
# Must be at least 32 characters — used as HMAC-SHA256 signing key
# ASP.NET Core config path: Jwt:Secret → env var: Jwt__Secret (double underscore = colon)
Jwt__Secret=replace-with-at-least-32-char-random-string

# ─── Database (production) ────────────────────────────────────────────────────
# SQLite is stored in the Docker named volume mounted at /data inside the backend container
# ASP.NET Core config path: ConnectionStrings:DefaultConnection → env var: ConnectionStrings__DefaultConnection
ConnectionStrings__DefaultConnection=Data Source=/data/mediatheque.db

# ─── CORS (production) ────────────────────────────────────────────────────────
# The domain(s) allowed to call the API — must match the Angular production URL exactly
# Multiple domains: comma-separated (e.g., https://a.com,https://b.com)
# ASP.NET Core config path: Cors:AllowedOrigins → env var: Cors__AllowedOrigins
Cors__AllowedOrigins=https://your-production-domain.com

# ─── Google Books API (Story 6.1) ─────────────────────────────────────────────
# Free tier, key required — https://console.cloud.google.com
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# ─── Daily SQLite backup (host cron — run on the VPS, not inside Docker) ──────
# Add this to crontab (crontab -e) on the VPS host:
#
#   0 2 * * * docker run --rm \
#     -v portail-mediatheque-conviale_db-data:/data \
#     -v /opt/backups/mediatheque:/backup \
#     alpine cp /data/mediatheque.db /backup/mediatheque-$(date +\%Y\%m\%d).db
#
# Note: "portail-mediatheque-conviale_db-data" is the Docker volume name
# (Compose prefixes the volume with the project directory name — verify with: docker volume ls)
